# Backend (all optional - defaults shown)
DATABASE_PATH=backend/data/library.db
# Absolute path to the compiled C engine if not engine/build/libtitlesearch.so
TITLESEARCH_LIB=
# Comma-separated origins allowed to call the API (only needed when the
# frontend is served from a different origin, e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173
# Where the built React app lives (served by FastAPI when present)
FRONTEND_DIST=frontend/dist

# Frontend (Vite). Leave empty when the API is on the same origin.
VITE_API_BASE=
